{
  "info": {
    "name": "Masterok-Asana API",
    "description": "API для управління Timer, ActOfWork та ActOfWorkDetail",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/admin/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Timer API",
      "item": [
        {
          "name": "Get Timers List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/timer/list?status=0&archive=0&per-page=20",
              "host": ["{{baseUrl}}"],
              "path": ["timer", "list"],
              "query": [
                {
                  "key": "status",
                  "value": "0",
                  "description": "Статус таймера (0-5)"
                },
                {
                  "key": "archive",
                  "value": "0",
                  "description": "Архівний статус (0-1)"
                },
                {
                  "key": "per-page",
                  "value": "20",
                  "description": "Кількість записів на сторінці"
                }
              ]
            }
          }
        },
        {
          "name": "Get Timer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/timer/view?id=1",
              "host": ["{{baseUrl}}"],
              "path": ["timer", "view"],
              "query": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID таймера"
                }
              ]
            }
          }
        },
        {
          "name": "Create Timer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_gid\": \"12345\",\n  \"time\": \"02:30:00\",\n  \"coefficient\": 1.2,\n  \"comment\": \"Робота над задачею\",\n  \"status\": 0,\n  \"archive\": 0,\n  \"status_act\": \"ok\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/timer/create",
              "host": ["{{baseUrl}}"],
              "path": ["timer", "create"]
            }
          }
        },
        {
          "name": "Update Timer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"time\": \"03:00:00\",\n  \"coefficient\": 1.5,\n  \"comment\": \"Оновлений коментар\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/timer/update?id=1",
              "host": ["{{baseUrl}}"],
              "path": ["timer", "update"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Timer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/timer/delete?id=1",
              "host": ["{{baseUrl}}"],
              "path": ["timer", "delete"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get Timer Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/timer/statistics?status=0&archive=0",
              "host": ["{{baseUrl}}"],
              "path": ["timer", "statistics"],
              "query": [
                {
                  "key": "status",
                  "value": "0"
                },
                {
                  "key": "archive",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Toggle Timer Archive",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/timer/toggle-archive?id=1",
              "host": ["{{baseUrl}}"],
              "path": ["timer", "toggle-archive"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
